# Agent git identity for Claude Code under DOTPICKLES_ROLE=work.
# See doc/adr/0031-role-scoped-agent-git-identity.md and
# doc/adr/0055-agent-git-over-ssh-through-the-relay.md.
#
# Referenced via GIT_CONFIG_GLOBAL in claude/roles/work.jsonc. The [include]
# below pulls in the shared behavior fragments directly -- NOT ~/.gitconfig
# itself, mirroring claude-agent-home, so a future work-role rewrite added to
# ~/.gitconfig.local can never leak into agent sessions the way home's did
# before d865817.
#
# Later sections here override: user.email and gpg.ssh.program=ssh-keygen to
# defeat the 1Password op-ssh-sign default (which needs interactive Touch
# ID). No core.sshCommand override: ssh/config.d/auth's Match block already
# selects the work agent key exclusively, and ssh/config.d/agent-relay's
# Match block already routes through the com.technicalpickles.agent-ssh-relay
# LaunchAgent's SOCKS5 relay (see ssh/CLAUDE.md) -- both keyed on
# $CLAUDECODE, so plain `ssh` already does the right thing for agent sessions
# without git needing to know about it.
[include]
	path = ~/.gitconfig.d/common
	path = ~/.gitconfig.d/alias
	path = ~/.gitconfig.d/color
	path = ~/.gitconfig.d/signing
[user]
	email = josh.nichols+agent@gusto.com
	signingkey = ~/.ssh/agents/work/id_ed25519.pub
[core]
	# fsmonitor's IPC daemon misbehaves under the Claude Code sandbox, surfacing
	# "could not read IPC response" on every git op even when nothing is wrong.
	# Disable it for agent sessions only — your interactive shell still inherits
	# fsmonitor=true from ~/.gitconfig.
	fsmonitor = false
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-keygen
# gist.github.com isn't in the agent-ssh-relay allowlist (config/gost/
# agent-ssh-relay.yml only lists github.com:22), so it still goes over
# HTTPS via gh's credential helper.
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
