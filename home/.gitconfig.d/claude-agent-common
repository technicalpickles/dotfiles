# Git preferences shared by every Claude Code agent role (claude-agent-home,
# claude-agent-work). Identity, signing, and relay-specific settings stay in the
# per-role files; anything that should behave the same for all agent sessions
# goes here so the roles never drift.
#
# No upstream tracking for agent branches. Tracking lives in .git/config, which
# the Claude Code sandbox (and safehouse's role-work.sb) denies, so a command
# that writes it fails after the push or ref change already landed (206 denials
# across 143 sessions, 2026-08-06 to 2026-10-26). autoSetupMerge = false stops
# `git switch -c x origin/x` from writing it. push.autoSetupRemote = true lives
# in home/.gitconfig (interactive only), not common, because a later `false`
# here could never undo it: git ORs every true value into a flag
# (builtin/push.c). push.default = current from common already pushes to the
# same-named branch, so agents don't need tracking. Home runs with the sandbox
# off since ADR 0066; keeping this on both roles keeps claude/rules/worktrees.md
# true everywhere.
[branch]
	autoSetupMerge = false
# fsmonitor's IPC daemon misbehaves under the Claude Code sandbox, surfacing
# "could not read IPC response" on every git op even when nothing is wrong.
# Agent sessions don't need it; the interactive shell keeps fsmonitor = true
# from common.
[core]
	fsmonitor = false
