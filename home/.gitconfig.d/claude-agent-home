# Agent git identity for Claude Code under DOTPICKLES_ROLE=home.
# See doc/adr/0031-role-scoped-agent-git-identity.md.
#
# The role is "home"; the key lives at ~/.ssh/agents/home to match the role
# (ADR 0039). The email stays joshua.nichols+personal-agent@gmail.com -- the
# GitHub-enrolled "personal-agent" address kept to preserve the Verified-badge
# enrollment until/unless it's re-enrolled under a home-named address.
#
# Referenced via GIT_CONFIG_GLOBAL in claude/roles/home.jsonc. The
# [include] pulls in the real global gitconfig first (transitively pulling
# in gitconfig.d fragments via ~/.gitconfig's own includes). Later sections
# here override: user.email, core.sshCommand for the agent SSH key, and
# gpg.ssh.program=ssh-keygen to defeat the 1Password op-ssh-sign default.
[include]
	path = ~/.gitconfig
[user]
	email = joshua.nichols+personal-agent@gmail.com
	signingkey = ~/.ssh/agents/home/id_ed25519.pub
[core]
	# -F /dev/null makes ssh ignore ~/.ssh/config entirely. Without it, the
	# `Host *` block's `IdentityFile ~/.ssh/id_ed25519` (the human laptop key)
	# leaks in as a second candidate identity: IdentityFile is additive, and
	# IdentitiesOnly=yes does not drop it. ssh could then auth to GitHub as the
	# human, or hard-fail headless if the agent can't sign the laptop key
	# ("sign_and_send_pubkey: ... communication with agent failed"). With -F we
	# use ONLY the agent key. IdentityAgent=SSH_AUTH_SOCK still resolves (env
	# var, not config) and points at the agent holding the unlocked agent key.
	sshCommand = ssh -F /dev/null -i ~/.ssh/agents/home/id_ed25519 -o IdentitiesOnly=yes -o IdentityAgent=SSH_AUTH_SOCK
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-keygen
# The Claude Code sandbox denies outbound port 22 at the TCP connect level, so
# any SSH remote (push/fetch/pull/clone) fails sandboxed regardless of which
# key or agent would authenticate -- confirmed in pickletown bean gt-o2jy.
# HTTPS to github.com already works sandboxed (that's the path gh/WebFetch
# use), so rewrite SSH remotes to HTTPS and hand auth off to gh's credential
# helper. This only affects agent sessions (this file is only reachable via
# GIT_CONFIG_GLOBAL) -- your interactive shell keeps using SSH normally.
[url "https://github.com/"]
	insteadOf = git@github.com:
[credential "https://github.com"]
	helper = !gh auth git-credential
