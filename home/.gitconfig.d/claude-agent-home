# Agent git identity for Claude Code under DOTPICKLES_ROLE=home.
# See doc/adr/0031-role-scoped-agent-git-identity.md.
#
# The role is "home"; the key lives at ~/.ssh/agents/home to match the role
# (ADR 0039). The email stays joshua.nichols+personal-agent@gmail.com -- the
# GitHub-enrolled "personal-agent" address kept to preserve the Verified-badge
# enrollment until/unless it's re-enrolled under a home-named address.
#
# Referenced via GIT_CONFIG_GLOBAL in claude/roles/home.jsonc. The [include]
# below pulls in the shared behavior fragments directly -- NOT ~/.gitconfig
# itself, because that transitively includes ~/.gitconfig.local, which
# carries the interactive-only home-role decision to rewrite git@github.com:
# remotes to HTTPS (gitconfig.sh, "rewrite SSH github.com remotes to HTTPS
# (home role only)"). git's url.*.insteadOf can't be cleanly undone by a
# later config file once inherited, so the only way to keep agent sessions
# on real SSH (via the agent-ssh-relay, see ssh/CLAUDE.md) is to never
# inherit that rewrite in the first place. Interactive shells still get it
# via ~/.gitconfig -> ~/.gitconfig.local, unaffected.
#
# Later sections here override: user.email and gpg.ssh.program=ssh-keygen
# to defeat the 1Password op-ssh-sign default (which needs interactive
# Touch ID). No core.sshCommand override: ssh/config.d/auth's Match block
# already selects the home agent key exclusively (IdentitiesOnly yes plus
# an explicit IdentityFile, no competing Host * IdentityFile to leak in),
# and ssh/config.d/agent-relay's Match block already routes through the
# com.technicalpickles.agent-ssh-relay LaunchAgent's SOCKS5 relay (see
# ssh/CLAUDE.md) -- both keyed on $CLAUDECODE, so plain `ssh` already does
# the right thing for agent sessions without git needing to know about it.
# Verified with `ssh -G git@github.com` under this role/env: exactly one
# identityfile (the agent key), identitiesonly yes, and the relay's
# proxycommand, all resolved from ~/.ssh/config alone.
[include]
	path = ~/.gitconfig.d/common
	path = ~/.gitconfig.d/alias
	path = ~/.gitconfig.d/color
	path = ~/.gitconfig.d/signing
[user]
	email = joshua.nichols+personal-agent@gmail.com
	signingkey = ~/.ssh/agents/home/id_ed25519.pub
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-keygen
# gist.github.com isn't in the agent-ssh-relay allowlist (config/gost/
# agent-ssh-relay.yml only lists github.com:22), so it still goes over
# HTTPS via gh's credential helper.
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
