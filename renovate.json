{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 5am on monday"],
  "minimumReleaseAge": "7 days",
  "mise": {
    "managerFilePatterns": [
      "/^config/mise/(config|(conf\\.d|home)/[^/]+)\\.toml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Cursor CLI has no releases API; its install script embeds the current version. Annotated entries in config/mise/conf.d and config/mise/home.",
      "customType": "regex",
      "managerFilePatterns": ["/^config/mise/(conf\\.d|home)/[^/]+\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+version = \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "customDatasources": {
    "cursor-agent": {
      "defaultRegistryUrlTemplate": "https://cursor.com/install",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": [releases[$contains(version, /DOWNLOAD_URL=/)].{ \"version\": $match(version, /lab\\/([^\\/]+)\\//).groups[0] }] }"
      ]
    },
    "onepassword-cli": {
      "defaultRegistryUrlTemplate": "https://app-updates.agilebits.com/check/1/0/CLI2/en/2.0.0/N",
      "format": "json",
      "transformTemplates": ["{ \"releases\": [{ \"version\": version }] }"]
    }
  },
  "packageRules": [
    {
      "description": "Cursor's install script has no release timestamps, so the cooldown can never be satisfied; skip it. Weekly build-stamped versions: no automerge, bump by PR.",
      "matchDatasources": ["custom.cursor-agent"],
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "1Password CLI is closed source: no GitHub repo for the aqua/github-tags lookup to find. Look it up from 1Password's update feed instead. The feed has no release timestamps, so the cooldown can never be satisfied; skip it.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["1password/cli"],
      "overrideDatasource": "custom.onepassword-cli",
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dev dependencies",
      "automerge": true
    },
    {
      "description": "mise strips the v prefix from github tags, but Renovate writes the raw tag back.",
      "matchManagers": ["mise"],
      "extractVersion": "^v?(?<version>.+)$"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools",
      "automerge": true
    },
    {
      "description": "Pinned on purpose (see comments in config/mise/conf.d/dotfiles.toml): bump by hand, never automerge.",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "github:DeusData/codebase-memory-mcp",
        "npm:ccstatusline"
      ],
      "groupName": null,
      "automerge": false
    }
  ]
}
