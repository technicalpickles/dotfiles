{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 5am on monday"],
  "minimumReleaseAge": "7 days",
  "mise": {
    "managerFilePatterns": ["/^config/mise/(config|conf\\.d/[^/]+)\\.toml$/"]
  },
  "customDatasources": {
    "onepassword-cli": {
      "defaultRegistryUrlTemplate": "https://app-updates.agilebits.com/check/1/0/CLI2/en/2.0.0/N",
      "format": "json",
      "transformTemplates": ["{ \"releases\": [{ \"version\": version }] }"]
    }
  },
  "packageRules": [
    {
      "description": "1Password CLI is closed source: no GitHub repo for the aqua/github-tags lookup to find. Look it up from 1Password's update feed instead. The feed has no release timestamps, so the cooldown can never be satisfied; skip it.",
      "matchManagers": ["mise"],
      "matchPackageNames": ["1password/cli"],
      "overrideDatasource": "custom.onepassword-cli",
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm dev dependencies",
      "automerge": true
    },
    {
      "description": "mise strips the v prefix from github tags, but Renovate writes the raw tag back.",
      "matchManagers": ["mise"],
      "extractVersion": "^v?(?<version>.+)$"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "mise tools",
      "automerge": true
    },
    {
      "description": "Pinned on purpose (see comments in config/mise/conf.d/dotfiles.toml): bump by hand, never automerge.",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "github:DeusData/codebase-memory-mcp",
        "npm:ccstatusline"
      ],
      "groupName": null,
      "automerge": false
    }
  ]
}
