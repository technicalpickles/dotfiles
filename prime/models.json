{
  // Local Ollama, which also serves cloud models (:cloud, -cloud) after
  // `ollama signin`. Newest of each family; a :cloud name works without a pull,
  // and retired models error with a suggested replacement. The server holds the sign-in, so no real key lives here:
  // apiKey is required by prime-agent but Ollama ignores it. Linked to
  // ~/.prime/agent/models.json by prime.sh.
  "providers": {
    "ollama": {
      "baseUrl": "http://localhost:11434/v1",
      "api": "openai-completions",
      "apiKey": "ollama",
      "models": [
        { "id": "glm-5.3:cloud" },
        { "id": "kimi-k3:cloud" },
        { "id": "minimax-m3.1-flash:cloud" },
        { "id": "mistral-large-4:cloud" },
        { "id": "deepseek-v4.1-flash:cloud" },
        { "id": "gpt-oss:120b-cloud" },
        { "id": "nemotron-3-ultra:cloud" },
        { "id": "gemma4:31b-cloud" }
      ]
    }
  }
}
