{
  // Work role settings (values from live settings, not stale source files)
  "awsAuthRefresh": "aws sso login --profile $AWS_PROFILE",
  // Work role agent identity (mirrors home.jsonc, see ADR 0031).
  // Claude Code sessions under DOTPICKLES_ROLE=work commit and push as
  // josh.nichols+agent@gusto.com via the agent key at
  // ~/.ssh/agents/work/id_ed25519, instead of going through 1Password
  // GPG. Prerequisite: bin/setup-agent-ssh-key work --email
  // josh.nichols+agent@gusto.com, then the printed GitHub enrollment
  // checklist.
  "env": {
    "GIT_CONFIG_GLOBAL": "~/.gitconfig.d/claude-agent-work",
    // too many
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    // Loses to the harness's injected GIT_SSH_COMMAND inside the sandbox --
    // the SessionStart hook below is what actually makes this stick. See
    // ADR 0055 and home.jsonc for the full explanation.
    "GIT_SSH_COMMAND": "ssh",
  },

  // Work-specific permissions
  "permissions": {
    "allow": [
      "Bash(bin/rspec:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle install)",
      "Bash(npx bktide build:*)",
      "Bash(npx bktide)",
      "Bash(npx bktide:*)",
    ],
  },

  // Work-specific sandbox: all of it (AWS SSO/Bedrock/ECR endpoints, Gusto
  // internal hostnames, the buildkite artifacts bucket) lives in the private
  // overlay now, not here -- this repo is public. See requiresPrivateOverlay
  // below and ADR 0056.

  // Auto mode classifier rules: intentionally absent from this file.
  //
  // base.jsonc's org-shaped slots carry the shipped "None configured" text.
  // That is correct at home and flatly wrong here -- a classifier told there
  // is no organization judges an upload to a Gusto host as an upload to a
  // stranger -- so the work role does need its own environment bullets.
  //
  // They just cannot live here: this repo is public, and a filled-in work
  // environment block spells out org name, internal services, deploy targets
  // and protected namespaces in one place.
  //
  // They live in ~/.config/dotpickles/roles/work.jsonc instead, which
  // claudeconfig.sh merges last. Generate it by running /auto-mode-setup on
  // the work machine and moving the autoMode block it writes into that file.
  // See ADR 0056. The sandbox block above lives in that same overlay file.
  // On this machine that overlay path is a symlink into pickleton (private,
  // versioned: config/dotpickles/roles/work.jsonc there), not a hand-carried
  // file.
  //
  // The flag below is not a Claude Code setting -- claudeconfig.sh strips it
  // and uses it to warn when the overlay is missing, so this role never
  // quietly generates with base.jsonc's placeholder answers.
  "requiresPrivateOverlay": true,

  // Pickleton session tracking hooks (global so they fire in all directories,
  // not just when Claude starts in ~/pickleton itself)
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.pickles/bin/pickletown claude-hook session-start",
          },
        ],
      },
      // Makes GIT_SSH_COMMAND=ssh actually stick inside the sandbox, where
      // the role env block above loses to the harness's later injection.
      // $CLAUDE_ENV_FILE is read afterward into a cached session-environment
      // script and wins. See ADR 0055 and home.jsonc for the full writeup.
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'export GIT_SSH_COMMAND=ssh' >> \"$CLAUDE_ENV_FILE\"",
          },
        ],
      },
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.pickles/bin/pickletown claude-hook skill-session-tracking",
          },
        ],
      },
    ],
  },
}
