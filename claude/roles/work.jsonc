{
  // Work role settings (values from live settings, not stale source files)
  "awsAuthRefresh": "aws sso login --profile $AWS_PROFILE",
  // Work role agent identity (mirrors home.jsonc, see ADR 0031).
  // Claude Code sessions under DOTPICKLES_ROLE=work commit and push as
  // josh.nichols+agent@gusto.com via the agent key at
  // ~/.ssh/agents/work/id_ed25519, instead of going through 1Password
  // GPG. Prerequisite: bin/setup-agent-ssh-key work --email
  // josh.nichols+agent@gusto.com, then the printed GitHub enrollment
  // checklist.
  "env": {
    "GIT_CONFIG_GLOBAL": "~/.gitconfig.d/claude-agent-work",
    // too many
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
  },

  // Work-specific permissions
  "permissions": {
    "allow": [
      "Bash(bin/rspec:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle install)",
      "Bash(npx bktide build:*)",
      "Bash(npx bktide)",
      "Bash(npx bktide:*)",
    ],
  },

  // Work-specific sandbox (source: agent-safehouse)
  "sandbox": {
    "network": {
      "allowedDomains": [
        // AWS SSO login + STS/OIDC token exchange
        "portal.sso.us-west-2.amazonaws.com",
        "oidc.us-west-2.amazonaws.com",
        "sts.us-west-2.amazonaws.com",
        // Bedrock (Claude Code via Bedrock, plus direct model calls)
        "bedrock.us-west-2.amazonaws.com",
        "bedrock-runtime.us-west-2.amazonaws.com",
        "api.ecr.us-west-2.amazonaws.com",
        // Buildkite artifact downloads
        "gusto-buildkite-artifacts-us-west-2.s3.us-west-2.amazonaws.com",
        // Gusto internal services
        "app.gusto-dev.com",
        "devotel.uw2.staging.zp-int.com",
        "flight-deck.prod.zp-int.com",
        "gusto.runlayer.com",
        "http-intake.logs.us5.datadoghq.com",
      ],
    },
  },

  // Pickleton session tracking hooks (global so they fire in all directories,
  // not just when Claude starts in ~/pickleton itself)
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.pickles/bin/pickletown claude-hook session-start",
          },
        ],
      },
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "~/.pickles/bin/pickletown claude-hook skill-session-tracking",
          },
        ],
      },
    ],
  },
}
