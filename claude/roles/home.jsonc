{
  // Home role agent identity (see ADR 0031).
  // Every Claude Code session under DOTPICKLES_ROLE=home commits and
  // pushes as a dedicated agent identity instead of the user's 1Password
  // GPG flow, which requires interactive approval.
  //
  // The key lives at ~/.ssh/agents/home to match the role (ADR 0039). The
  // email stays joshua.nichols+personal-agent@gmail.com -- the GitHub-enrolled
  // "personal-agent" address, kept to preserve the Verified-badge enrollment
  // until/unless it's re-enrolled under a home-named address.
  //
  // Prerequisite (already done on this machine): recreate with
  // `bin/setup-agent-ssh-key home --email joshua.nichols+personal-agent@gmail.com`
  // then complete the printed GitHub enrollment steps.
  // GIT_CONFIG_GLOBAL swaps in an agent-specific gitconfig for Claude-spawned
  // shells. The target file [include]s ~/.gitconfig then overrides user.email,
  // core.sshCommand, and gpg.ssh.program (resets 1Password's op-ssh-sign to
  // ssh-keygen). Leading ~/ is expanded by claudeconfig.sh before writing
  // settings.json (GIT_CONFIG_GLOBAL itself does not expand ~).
  // GIT_SSH_COMMAND is set to plain `ssh` to *defeat* the value Claude Code's
  // sandbox injects into every Bash tool call (a hardcoded template in the
  // CLI binary: `ssh -o ControlMaster=no -o ControlPath=none -o
  // ProxyCommand='nc -X 5 -x localhost:<per-session-port> %h %p'`). That
  // points git at the harness's own SOCKS proxy, which refuses SSH outright:
  // it answers the handshake itself as SSH-2.0-policy_refusal ("This proxy
  // requires authentication, and this client did not offer an authentication
  // method"), drops the connection after KEXINIT, and never dials the real
  // host -- surfacing to git as `ssh_dispatch_run_fatal: Connection to
  // UNKNOWN port 65535: Broken pipe`. This is NOT github.com missing from
  // sandbox.network.allowedDomains below; a denied host gives SOCKS error 2
  // on :443, which is a different failure.
  //
  // git resolves GIT_SSH_COMMAND ahead of core.sshCommand and ssh_config, so
  // the injected value silently defeats the agent-ssh-relay (ssh/CLAUDE.md)
  // no matter what git config says -- that's why claude-agent-home carries no
  // core.sshCommand override; it could never win. Setting it to bare `ssh`
  // hands resolution back to ~/.ssh/config, whose $CLAUDECODE Match blocks
  // already pick the home agent key and route github.com through the gost
  // relay.
  //
  // IMPORTANT: this entry does NOT win inside the sandbox. Verified from a
  // session started after ./claudeconfig.sh -- the harness injects its value
  // after role env, so sandboxed Bash calls still see the proxy command and
  // git-over-SSH still fails. What this entry buys is the unsandboxed case
  // (dangerouslyDisableSandbox, where no proxy exists and no injection
  // happens): there `GIT_SSH_COMMAND=ssh` is what lands, and git reaches
  // github.com through the relay. Sandboxed, the only workarounds are an
  // explicit `GIT_SSH_COMMAND=ssh git ...` per command, or running the git
  // command unsandboxed. See bean dotfiles-mo7y and ssh/CLAUDE.md.
  "env": {
    "GIT_CONFIG_GLOBAL": "~/.gitconfig.d/claude-agent-home",
    "GIT_SSH_COMMAND": "ssh",
  },

  // Sandbox off for the home role (ADR 0066). The allowlists below are
  // inert while it's off; they stay so flipping "enabled" back is one line.
  "sandbox": {
    "enabled": false,
    "network": {
      "allowedDomains": [
        "brineworks.tail2023b7.ts.net",
        "woodpecker.tail2023b7.ts.net",
      ],
    },
    "filesystem": {
      "allowWrite": ["~/Library/Caches/f3d"],
    },
  },

  // Auto mode: base.jsonc holds the role-invariant, "None configured"
  // picture; this adds what's specific to this machine and its personal
  // repos. A bullet here replaces the base bullet carrying the same
  // **Label**. See ADR 0056 and claude/README.md's Auto Mode Rules table
  // ("Home-only additions" -> roles/home.jsonc).
  //
  // The dev-VM-vs-production split below is the key thing this role adds:
  // pickled-coi is disposable and safe to experiment on; picklelab/picklehome
  // is real infrastructure (including physical-world effects: HVAC, the
  // garage door) and should get the same caution as any other prod system.
  "autoMode": {
    // Deploys. `just deploy-*` from the picklehome checkout is the one deploy
    // path to picklelab (pushes a clean main, then one ssh). picklehome's own
    // .claude/settings.json pre-authorizes it, but only for sessions started
    // in that repo; from ~/github.com the classifier's Production Deploy rule
    // applied and wanted the message to spell out the deploy. Three real
    // denials on "go ahead with merge and whatnot"-shaped asks; see
    // taskwarrior 198edeb1.
    //
    // deploy-openclaw and deploy-brineworks-server are the consequential
    // ones: both restart what a live Brent turn runs on. Their guard is not
    // this rule but the host-side quiet check (picklehome ADR 0003) plus the
    // PreToolUse hook below, which turns a busy host into a prompt.
    "allow": [
      "`just deploy-<service>`, run with the cwd (or a preceding `cd`) under `~/github.com/technicalpickles/picklehome` or one of its git worktrees, is the user's (Josh's) one documented deploy path to picklelab. The recipe pushes a clean `main` and then runs one ssh command on picklelab; that push and that ssh are part of the deploy, not separate Remote Shell Writes or pushes to judge on their own. When the user's message in this session asked to deploy, ship, release or roll out that service, or to merge and deploy its PR, the deploy is wanted even if the message did not spell out the `just` recipe; that is not Production Deploy without consent. This rule clears only the deploy: a merge step still falls under Merge Without Review, and the rule does not apply if the agent edited the `Justfile` or the deploy scripts it calls during this session. `deploy-openclaw` and `deploy-brineworks-server` restart Brent (the Telegram bot) and carry their own guard: the deploy refuses while a Brent session was active in the last 5 minutes and a PreToolUse hook asks the user first, so judge them the same way. `HOMELAB_DEPLOY_EVEN_IF_BUSY=1` is that guard's documented override: not a Safety Bypass Flag when the user said to deploy even if Brent is busy, and a Safety Bypass Flag otherwise. A deploy nobody asked for is still Production Deploy.",
      // picklelab reads. About 15 denials as Production Reads for docker ps,
      // --version, systemctl is-active, cron list, a SELECT (taskwarrior
      // f54dd775). The exclusions are the files on picklelab that hold tokens.
      "Read-only inspection of `picklelab`, the user's (Josh's) own single-user homelab host, over `ssh picklelab` is routine inspection, not Production Reads: `docker ps`, `docker logs`, `docker inspect` (except its Env output), `docker exec <container>` running a read-only command (`ls`, `cat` of app state or logs, `--version`, `--help`, `openclaw cron list`, `openclaw sessions`, a SQL `SELECT`), `systemctl status` and `is-active`, `df`, `journalctl`, `ls` of data directories, and read-only queries against `brineworks.tail2023b7.ts.net`. Still Production Reads even on picklelab: dumping a process or container environment (`/proc/*/environ`, `env`, `printenv`, the Env section of `docker inspect`), printing secret or token files (`.env`, anything matching `*token*` or `*secret*`, `exec-approvals.json`, the auth or gateway sections of `openclaw.json`), and keyrings or keychains. Anything that writes on picklelab is unchanged: Remote Shell Writes and Production Deploy apply as written.",
      // Worktree and merged-branch cleanup. About 10 denials as Irreversible
      // Local Destruction for wt remove, deleting merged remote branches and
      // resumed .parkinglot handoffs (taskwarrior 7f54075f). wt already refuses
      // dirty trees and keeps unmerged branches.
      "`wt remove <branch>` (worktrunk) without `-f`, `--force`, `-D` or `--force-delete`, and `git worktree remove` without `--force`, on a worktree under `<repo>/.claude/worktrees/` in one of the user's own repos (`~/github.com/technicalpickles/*`) is routine cleanup, not Irreversible Local Destruction or Interfere With Workloads: wt refuses a dirty worktree and keeps an unmerged branch on its own, so nothing uncommitted or unmerged is lost. Deleting that branch's remote after its PR merged (`git push origin --delete <branch>`, `gh pr merge --delete-branch`, `git branch -d`) is the same cleanup, not Git Destructive, and so is deleting a `.parkinglot/<name>.md` handoff that was resumed in this session. With `-f`, `-D` or `--force`, or on a branch whose PR has not merged, the defaults apply and the user has to have named the worktree or branch.",
      // Reset with a safety net. A bare `git reset --hard` on a clean main was
      // denied today; the classifier cannot see that the tree is clean, but it
      // can see a backup ref made in the same command.
      "In the user's own repos (`~/github.com/technicalpickles/*`), `git reset --hard <ref>`, `git reset --keep <ref>` and `git checkout -- <paths>` are allowed when the same command first records a safety net that keeps the discarded state reachable: a backup branch or tag (`git branch backup/<name> && git reset --hard <ref>`) or `git stash push -u -m <tag>`. A bare `git reset --hard` with no safety net in the same command stays Irreversible Local Destruction as written.",
      // Branch update is not a PR merge. `git merge origin/main` into a feature
      // branch and invoking the park skill were both denied as Merge Without
      // Review.
      "Bringing the current feature branch up to date with its base (`git merge origin/main` or `git merge main` into the feature branch, `git rebase origin/main`, `git pull origin <branch>`, the desktop app's sync_with_base_branch tool) is updating a branch, not merging a pull request, and is not Merge Without Review. Invoking a Claude Code skill (`agent-meta:park`, `git:update` and the like) is not a merge either; judge the commands it then runs. Merging a PR (`gh pr merge`, merging a feature branch into `main`) is still Merge Without Review.",
      // Local dev lifecycle. Killing the agent's own dev server, orb stop,
      // docker stop of a local compose container, and pickleclaw's
      // dev-bw-server launchd install were denied as Interfere With Workloads
      // or Unauthorized Persistence.
      "On this Mac, stopping, restarting or killing local development processes is local development, not Interfere With Workloads: a process the agent or the user started on a dev port (`lsof -ti :<port>` then `kill <pid>` of that pid), containers of the pickleclaw dev VM (`dev-vm-*`, via `docker` or `orb`), `docker stop` and `docker rm` of a container that a repo's own compose file or script created on this machine, and `orb stop` or `orb start` of an OrbStack VM. The launchd agent that pickleclaw's `scripts/dev-bw-server install|stop|uninstall` manages is that script's documented lifecycle, not Unauthorized Persistence. Deleting a VM (`orb delete`), a Docker volume, or anything on picklelab still needs the user to have named it.",
      // Settled tailnet exposure. The PostToolUse hook below already says this is
      // pre-approved, but the classifier never reads hook output.
      "Exposing a loopback dev server to the user's own tailnet with `tailscale serve` (never `tailscale funnel`), and crit's `--allow-unauthenticated-network` flag, which is crit's own gate for exactly that tailnet exposure, are settled and pre-approved on this machine (this role's PostToolUse hook says the same): not Expose Local Services and not Safety Bypass Flag. `tailscale funnel`, binding a server to `0.0.0.0` or a LAN address, and `ssh -R` reverse tunnels stay as the defaults say.",
      // Maintaining the classifier from its source of truth. About 22 denials for
      // reading ADR 0056, base.jsonc, Claude Code's own permission docs, and
      // the 2026-09-09 session that built ADR 0056. Deliberately loosens
      // Self-Modification, scoped to this repo and to sessions where Josh
      // raised the topic; the result still lands as a reviewed PR.
      "In technicalpickles/dotfiles the auto-mode classifier rules live in `claude/roles/*.jsonc` and `claude/stacks/*.jsonc` and are generated into `~/.claude/settings.json` by `./claudeconfig.sh` (ADR 0056). When the user's (Josh's) task in this session is about those rules, the classifier or auto mode, because the user raised it in a message in this session, the following is routine maintenance, not Self-Modification or Auto-Mode Bypass: reading those sources, running `claude auto-mode config`, `defaults` or `critique`, reading Claude Code's own documentation on permissions, hooks and auto mode and this repo's ADRs and notes about them, editing those role and stack sources, running `./claudeconfig.sh`, and committing the result for review as a PR. It stays Self-Modification to hand-edit `~/.claude/settings.json` or any other generated file under `~/.claude/`, to edit these sources when the user's task in this session was about something else, or to add a rule the user did not ask for in this session.",
      // Don't inherit the previous denial. The largest bucket (about 28): right
      // after a real block, `git status`, `cat > todo.md` and `--help` took
      // its label. Low confidence this changes anything; re-check with the cq
      // query in scratch/automode-denials-2026-10-26.md.
      "Judge each command on what it does. After a command in this session was denied, a later command that only reads (`ls`, `cat`, `grep`, `git log`, `git status`, `git diff`, `cq sql`, `task export`, `--help`, running a test suite) or that edits files inside the trusted repo or the session scratchpad does not inherit the earlier denial's label unless it repeats or continues the denied action against the same target.",
    ],
    "environment": [
      "### Org-wide",
      "**Trusted internal domains**: `brineworks.tail2023b7.ts.net` (Tailscale tailnet, this machine's own node) and `woodpecker.tail2023b7.ts.net` (Woodpecker CI, same tailnet) — both allowlisted in the sandbox above; nothing else is internal",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment; also `picklelab` (personal homelab host, reached over Tailscale) and anything deployed there via the `picklehome` repo, even though the name itself doesn't say \"prod\"",
      "**Protected deployment namespaces / environments**: the personal homelab — the `picklelab` host and whatever `picklehome` (`~/github.com/technicalpickles/picklehome`, public) deploys onto it: home automation with physical-world effects (HVAC via `climate/`, the garage door via `garage/`) plus always-on app services like `brineworks-server` (see that repo's `docs/dev-vs-prod-pipeline.md`). Real production — treat `ssh picklelab`, and any `docker compose`/`just deploy-*`/`just climate-*`/`just garage-*` command that mutates state there, with the same caution as any other prod system",
      "### User-specific",
      "**Primary use of Claude Code**: personal software projects — dotfiles/dev-environment tooling (this repo), homelab ops (`picklehome`), and app development (e.g. `brineworks`) — spread across repos under `~/github.com/technicalpickles/` and the `pickled-coi` VM's mirror of them",
      "**Org-specific CLIs**: `beans` (agentic issue tracker), `herdr` (plugin manager, `config/herdr/plugins.toml`), `claudeconfig.sh`, `sshconfig.sh`, `gitconfig.sh`, `bin/adr` — all in `technicalpickles/dotfiles`, routine there",
      "routine under technicalpickles/dotfiles: edits to `claude/`, `.claude/rules/`, `home/`, `config/`, `ssh/config.d/` followed by the documented regeneration scripts (`claudeconfig.sh`, `sshconfig.sh`, `gitconfig.sh`)",
      "routine under technicalpickles/: work on the pickled-coi VM (an OrbStack VM, mirrors most of `~/github.com/technicalpickles/` under its own `~/projects/`) is ordinary development, not a remote-host escalation — see ~/github.com/CLAUDE.md. `picklelab`/`picklehome` (above) is the opposite of pickled-coi: real infrastructure, not a sandbox to experiment on freely",
    ],
  },

  // Nudge (non-blocking) when a Write/Edit lands a bare numeric task/plan-step
  // ID in a durable, resumed-later artifact (.parkinglot handoffs, .beans,
  // auto-memory files). See claude/rules/taskwarrior.md and bean
  // dotfiles-cokl -- this pattern caused repeated real damage (annotations
  // and `done` calls landing on the wrong taskwarrior task after ID drift).
  // Always returns permissionDecision "allow" (or {} on no match), so it
  // never blocks the write -- it only injects a reminder to resolve to a
  // UUID or a stable slug before finalizing.
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '.tool_input as $ti | ($ti.file_path // \"\") as $fp | ($ti.content // $ti.new_string // \"\") as $content | (($fp | test(\"\\\\.parkinglot/[^/]*\\\\.md$\")) or ($fp | test(\"\\\\.beans/[^/]*\\\\.md$\")) or ($fp | test(\"/\\\\.claude/projects/[^/]+/memory/[^/]*\\\\.md$\"))) as $in_scope | ($content | test(\"\\\\btask\\\\s*#?\\\\s*[0-9]{1,5}\\\\b\"; \"i\")) as $has_numeric_id | if ($in_scope and $has_numeric_id) then {hookSpecificOutput:{hookEventName:\"PreToolUse\", permissionDecision:\"allow\", additionalContext:\"This file (\\($fp)) is a durable/resumed-later artifact (.parkinglot, .beans, or auto-memory) per claude/rules/taskwarrior.md. It cites a bare numeric ID (e.g. \\\"task 465\\\"). These drift: taskwarrior integer IDs get reused as the pending list changes, and plan-step ordinals shift when steps are inserted or reordered. Resolve to a taskwarrior UUID (task <uuid> info) or a stable kebab-case slug before finalizing this write.\"}} else {} end' 2>/dev/null || true",
          },
        ],
      },
      {
        // Companion to the Write|Edit nudge above: catches the actual moment
        // of damage (a mutating `task` command run against a bare decimal
        // ID) instead of only warning once the ID lands in a file. Scoped to
        // Bash(task:*) via `if` so the jq filter doesn't run on every Bash
        // call. See the taskwarrior skill's "Durable references" section and
        // bean dotfiles-cokl -- this exact pattern (a cached numeric ID that
        // drifted mid-session) has caused annotate/done calls to silently
        // land on unrelated tasks more than once.
        "matcher": "Bash",
        "if": "Bash(task:*)",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '(.tool_input.command // \"\") as $c | ($c | test(\"\\\\btask\\\\s+([0-9]{1,6})\\\\s+(done|annotate|modify|depends|delete|start|stop)\\\\b\")) as $risky | if $risky then ($c | capture(\"\\\\btask\\\\s+(?<id>[0-9]{1,6})\\\\s+(?<verb>done|annotate|modify|depends|delete|start|stop)\\\\b\")) as $m | {hookSpecificOutput:{hookEventName:\"PreToolUse\", permissionDecision:\"allow\", additionalContext:\"This mutates taskwarrior task \\($m.id) by its plain numeric ID (`\\($m.verb)`). Numeric IDs are reused as the pending list reorders -- if this ID was captured more than a couple of commands ago (or anything else touched taskwarrior in between), re-resolve it first: `task \\($m.id) info` (or re-grep by description) to confirm it still points at the task you mean. See the taskwarrior skill Durable references section.\"}} else {} end' 2>/dev/null || true",
          },
        ],
      },
      // Brent quiet gate. Before `just deploy-openclaw` / `just
      // deploy-brineworks-server`, ask picklelab whether a Brent session was
      // active in the last 5 minutes (homelab/scripts/openclaw-quiet.sh in
      // picklehome, run over ssh). Busy becomes permissionDecision "ask", so
      // auto mode cannot approve the deploy silently; quiet is no opinion.
      // The deploy script repeats the check on the host, so this is the
      // early, human-facing copy of the same gate, not the only one.
      {
        "matcher": "Bash",
        "if": "Bash(just deploy-*)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.pickles/bin/claude-deploy-quiet-hook",
            "timeout": 45,
          },
        ],
      },
      // codebase-memory-mcp hooks: hand-wired because `install` writes machine-specific binary paths.
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp hook-augment 2>/dev/null || true",
            "timeout": 5,
          },
        ],
      },
    ],

    // crit's own CLI refuses to expose itself non-loopback without
    // --allow-unauthenticated-network, printing "refusing unauthenticated
    // network exposure" and exiting nonzero -- that refusal is crit's
    // safety gate, not a Claude Code permission check, but Claude has
    // repeatedly read it and paused to ask Josh whether the tailnet
    // exposure is OK anyway (confirmed 2026-08-07, 2026-09-05, 2026-09-19
    // via cq across three separate repos). Personal-tailnet exposure via
    // `tailscale serve` (never `funnel`) is already a settled answer; this
    // fires only at the exact moment crit's refusal appears, so it costs
    // nothing on sessions that never touch crit.
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '(.tool_output.output // \"\") as $out | ($out | test(\"refusing unauthenticated network exposure\")) as $refused | if $refused then {hookSpecificOutput:{hookEventName:\"PostToolUse\", additionalContext:\"That refusal is a safety gate built into crit itself, not a Claude Code permission check. Personal-tailnet exposure via tailscale serve (never funnel) plus the network-trust flag a tool requires for that (e.g. --allow-unauthenticated-network) is pre-approved -- retry with that flag added instead of asking the user first. This exact question has already been answered three times (2026-08-07, 2026-09-05, 2026-09-19).\"}} else {} end' 2>/dev/null || true",
          },
        ],
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp hook-augment 2>/dev/null || true",
            "timeout": 5,
          },
        ],
      },
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp hook-augment 2>/dev/null || true",
            "timeout": 5,
          },
        ],
      },
    ],

    // THIS is what makes GIT_SSH_COMMAND=ssh actually stick inside the
    // sandbox -- not the role "env" block above, which loses because Claude
    // Code injects its own GIT_SSH_COMMAND after user env. $CLAUDE_ENV_FILE is
    // a different, later channel: the CLI reads it into a cached "session
    // environment" script, and it's only populated for SessionStart/Setup/
    // CwdChanged/FileChanged hooks. It wins.
    //
    // Verified on 2.1.263 from a fresh session: `env` shows a bare
    // GIT_SSH_COMMAND=ssh, and sandboxed `git fetch`/`ls-remote` against
    // git@github.com: succeed through the agent-ssh-relay. No
    // dangerouslyDisableSandbox needed for agent git any more.
    //
    // Upstream bug: anthropics/claude-code#70684 (open since 2026-06-24, still
    // unfixed on 2.1.263) and its sharper duplicate #82255 (closed as stale,
    // not fixed). Root cause is in sandbox-runtime's generateProxyEnvVars():
    // the macOS branch builds a SOCKS5 `nc -X 5` ProxyCommand with no
    // credentials even when a proxy auth token is set, while the Linux branch
    // passes `proxyauth` to socat. The proxy then refuses with an
    // SSH-2.0-policy_refusal banner.
    //
    // Most people in that thread need an HTTP CONNECT helper or an insteadOf
    // rewrite to HTTPS, because the harness proxy is their only way out. We
    // don't: the agent-ssh-relay on 127.0.0.1:1080 already works sandboxed
    // (localhost is allowed), so bare `ssh` is all we need. This hook was
    // reported not to work on 2.1.191 back in June, which is why the thread
    // moved on to helper scripts -- it does work on 2.1.263. If a future
    // version reorders the env again, the symptom is the broken-pipe error
    // returning; fall back to `GIT_SSH_COMMAND=ssh git ...` per command.
    // See bean dotfiles-mo7y.
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'export GIT_SSH_COMMAND=ssh' >> \"$CLAUDE_ENV_FILE\"",
          },
        ],
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp hook-augment 2>/dev/null || true",
            "timeout": 5,
          },
        ],
      },
    ],
  },
}
