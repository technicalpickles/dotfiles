{
  // Base settings
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
  },
  "includeCoAuthoredBy": true,

  // without this, thinking isn't displayed in interactive mode or persisted to
  // session logs
  "showThinkingSummaries": true,

  // Push notifications for agent turn completion, and suppressing the
  // workflow usage warning. These settings persist across claudeconfig.sh.
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,

  // Keep session transcripts for a year instead of the 30-day default.
  //
  // Transcripts under ~/.claude/projects/ are the only record of what actually
  // happened in a session; pickletown's own session index stores just metadata
  // (session -> bean/repo refs), not content. At the default 30 days they age
  // out silently -- measured 2026-08-28: 1064 of 1202 transcript files were
  // under 30 days old, oldest survivor Jul 28, so the window was doing real
  // deleting. Anything wanting to look further back (cq queries, digging up how
  // a decision got made) had nothing to read.
  //
  // Cost is disk: ~800MB per 30 days measured, so on the order of 10GB/year.
  // Revisit if that gets annoying. Not set in managed settings, so this is
  // ours to choose.
  "cleanupPeriodDays": 365,

  // Pin the shell so the system prompt tells the truth about it.
  //
  // The Bash tool only ever runs bash or zsh. Its resolver reads $SHELL and,
  // when that is neither (our login shell is fish), silently falls back to zsh
  // (/bin/zsh on macOS). But the prompt's "Shell:" line is built from raw
  // $SHELL verbatim, so Claude is told "fish" while commands actually run in
  // zsh. Result: Claude blames fish for zsh behavior (e.g. `!` history
  // expansion, quoting) that fish never produced.
  //
  // Setting SHELL=/bin/zsh makes that prompt line match reality (it already
  // ran in zsh), so the misattribution stops. The Bash tool cannot run fish
  // regardless; this only corrects what Claude is told. Verified by reading
  // the bundled JS (resolver + prompt builder both key off process.env.SHELL).
  // See ADR 0038.
  // https://github.com/anthropics/claude-code/issues/68349
  "env": {
    "SHELL": "/bin/zsh",
    // Sandboxed network egress goes through a local MITM proxy advertised
    // via http_proxy/https_proxy. curl and git honor those; Node's global
    // fetch (undici) ignores them unless this is set, so any Node CLI that
    // uses fetch dies with a bare "fetch failed" even for an allowlisted
    // host. Node 24+ only. Found via mcporter, but it is not mcporter-
    // specific -- it hits every fetch-based Node tool.
    "NODE_USE_ENV_PROXY": "1",
  },

  // Permissions: base safety rules
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(rm -rf .DS_Store)",
      "Bash(rm -rf .cache)",
      "Bash(rm -rf .coverage)",
      "Bash(rm -rf .gradle)",
      "Bash(rm -rf .next)",
      "Bash(rm -rf .pytest_cache)",
      "Bash(rm -rf .rspec_cache)",
      "Bash(rm -rf .tmp)",
      "Bash(rm -rf ./build)",
      "Bash(rm -rf ./coverage)",
      "Bash(rm -rf ./dist)",
      "Bash(rm -rf ./node_modules)",
      "Bash(rm -rf ./out)",
      "Bash(rm -rf ./pkg)",
      "Bash(rm -rf ./target)",
      "Bash(rm -rf ./temp)",
      "Bash(rm -rf ./tmp)",
      "Bash(rm -rf ./vendor)",
      "Bash(rm -rf build)",
      "Bash(rm -rf coverage)",
      "Bash(rm -rf dist)",
      "Bash(rm -rf node_modules)",
      "Bash(rm -rf out)",
      "Bash(rm -rf pkg)",
      "Bash(rm -rf target)",
      "Bash(rm -rf temp)",
      "Bash(rm -rf tmp)",
      "Bash(sudo docker:*)",
      "Bash(sudo journalctl:*)",
      "Bash(sudo systemctl disable:*)",
      "Bash(sudo systemctl enable:*)",
      "Bash(sudo systemctl reload:*)",
      "Bash(sudo systemctl restart:*)",
      "Bash(sudo systemctl start:*)",
      "Bash(sudo systemctl status:*)",
      "Bash(sudo systemctl stop:*)",
    ],
    "ask": [
      "Bash(sudo chmod:*)",
      "Bash(sudo chown:*)",
      "Bash(sudo chgrp:*)",
      "Bash(sudo mkdir:*)",
      "Bash(sudo mv:*)",
      "Bash(sudo cp:*)",
      "Bash(sudo ln:*)",
      "Bash(sudo kill:*)",
      "Bash(sudo killall:*)",
      "Bash(sudo shutdown:*)",
      "Bash(sudo reboot:*)",
      "Bash(sudo halt:*)",
      "Bash(sudo apt-get:*)",
      "Bash(sudo yum:*)",
      "Bash(sudo dnf:*)",
    ],
    "deny": [
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(sudo rm -rf:*)",
      "Bash(sudo dd:*)",
      "Bash(sudo mkfs:*)",
      "Bash(sudo fdisk:*)",
      "Bash(sudo parted:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf .:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf ../*:*)",
    ],
  },

  // Sandbox: base config (source: agent-safehouse)
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    // (macOS only) Allow access to the system TLS trust service
    // (com.apple.trustd.agent). Required for Go-based tools like gh,
    // gcloud, and terraform to verify TLS certificates when using
    // httpProxyPort with a MITM proxy and custom CA.
    "enableWeakerNetworkIsolation": true,
    "network": {
      // Permits git commit signing, git fsmonitor, Docker socket, etc.
      "allowAllUnixSockets": true,
      // gusto.runlayer.com fronts every Gusto MCP server (Glean, Jira,
      // Slack, gdocs, ...). Claude Code's own MCP client isn't sandboxed,
      // but mcporter is -- it reads those same servers out of ~/.claude.json
      // and calls them from Bash, so without this every `mcporter list`
      // or `mcporter call` against a Gusto server dies on "fetch failed".
      "allowedHosts": [
        "api.anthropic.com",
        "code.claude.com",
        "gusto.runlayer.com",
      ],
      // local dev servers, and other things that are weird and listen (clippy
      // --fix for some reason??)
      "allowLocalBinding": true,
    },
    "filesystem": {
      "allowWrite": [
        // rtk (CLI proxy) needs to write its state/config here
        "~/Library/Application Support/rtk",
        // Plain /tmp writes (as opposed to $TMPDIR) are the single biggest
        // source of self-inflicted sandbox EPERM noise -- redirects, quick
        // scratch files, background-job logs, etc. all default to /tmp out
        // of habit despite $TMPDIR being the documented scratch dir. Allow
        // it outright rather than fighting the habit.
        //
        // NOTE: on macOS this entry alone is a no-op. /tmp is a symlink to
        // /private/tmp and Seatbelt matches resolved paths, so the rule never
        // fires. claudeconfig.sh adds the "/private/tmp" twin at generate
        // time (and does the same for any /var or /etc entry), which is what
        // actually makes this work. Leave the plain spelling here: it is the
        // one that matters on Linux.
        "/tmp",
        // mcporter caches OAuth tokens here and mkdirs it on every run,
        // even for servers that authenticate with a plain header. Without
        // it the very first thing any mcporter invocation prints is
        // "EPERM: operation not permitted, mkdir '~/.mcporter'".
        "~/.mcporter",
      ],
    },
  },
}
