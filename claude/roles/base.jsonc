{
  // Base settings
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0,
  },
  "includeCoAuthoredBy": true,

  // without this, thinking isn't displayed in interactive mode or persisted to
  // session logs
  "showThinkingSummaries": true,

  // Push notifications for agent turn completion, and suppressing the
  // workflow usage warning. These settings persist across claudeconfig.sh.
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,

  // Pin the shell so the system prompt tells the truth about it.
  //
  // The Bash tool only ever runs bash or zsh. Its resolver reads $SHELL and,
  // when that is neither (our login shell is fish), silently falls back to zsh
  // (/bin/zsh on macOS). But the prompt's "Shell:" line is built from raw
  // $SHELL verbatim, so Claude is told "fish" while commands actually run in
  // zsh. Result: Claude blames fish for zsh behavior (e.g. `!` history
  // expansion, quoting) that fish never produced.
  //
  // Setting SHELL=/bin/zsh makes that prompt line match reality (it already
  // ran in zsh), so the misattribution stops. The Bash tool cannot run fish
  // regardless; this only corrects what Claude is told. Verified by reading
  // the bundled JS (resolver + prompt builder both key off process.env.SHELL).
  // See ADR 0038.
  // https://github.com/anthropics/claude-code/issues/68349
  "env": {
    "SHELL": "/bin/zsh",
  },

  // Permissions: base safety rules
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(rm -rf .DS_Store)",
      "Bash(rm -rf .cache)",
      "Bash(rm -rf .coverage)",
      "Bash(rm -rf .gradle)",
      "Bash(rm -rf .next)",
      "Bash(rm -rf .pytest_cache)",
      "Bash(rm -rf .rspec_cache)",
      "Bash(rm -rf .tmp)",
      "Bash(rm -rf ./build)",
      "Bash(rm -rf ./coverage)",
      "Bash(rm -rf ./dist)",
      "Bash(rm -rf ./node_modules)",
      "Bash(rm -rf ./out)",
      "Bash(rm -rf ./pkg)",
      "Bash(rm -rf ./target)",
      "Bash(rm -rf ./temp)",
      "Bash(rm -rf ./tmp)",
      "Bash(rm -rf ./vendor)",
      "Bash(rm -rf build)",
      "Bash(rm -rf coverage)",
      "Bash(rm -rf dist)",
      "Bash(rm -rf node_modules)",
      "Bash(rm -rf out)",
      "Bash(rm -rf pkg)",
      "Bash(rm -rf target)",
      "Bash(rm -rf temp)",
      "Bash(rm -rf tmp)",
      "Bash(sudo docker:*)",
      "Bash(sudo journalctl:*)",
      "Bash(sudo systemctl disable:*)",
      "Bash(sudo systemctl enable:*)",
      "Bash(sudo systemctl reload:*)",
      "Bash(sudo systemctl restart:*)",
      "Bash(sudo systemctl start:*)",
      "Bash(sudo systemctl status:*)",
      "Bash(sudo systemctl stop:*)",
    ],
    "ask": [
      "Bash(sudo chmod:*)",
      "Bash(sudo chown:*)",
      "Bash(sudo chgrp:*)",
      "Bash(sudo mkdir:*)",
      "Bash(sudo mv:*)",
      "Bash(sudo cp:*)",
      "Bash(sudo ln:*)",
      "Bash(sudo kill:*)",
      "Bash(sudo killall:*)",
      "Bash(sudo shutdown:*)",
      "Bash(sudo reboot:*)",
      "Bash(sudo halt:*)",
      "Bash(sudo apt-get:*)",
      "Bash(sudo yum:*)",
      "Bash(sudo dnf:*)",
    ],
    "deny": [
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(sudo rm -rf:*)",
      "Bash(sudo dd:*)",
      "Bash(sudo mkfs:*)",
      "Bash(sudo fdisk:*)",
      "Bash(sudo parted:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf .:*)",
      "Bash(rm -rf ..:*)",
      "Bash(rm -rf ../*:*)",
    ],
  },

  // Sandbox: base config (source: agent-safehouse)
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    // (macOS only) Allow access to the system TLS trust service
    // (com.apple.trustd.agent). Required for Go-based tools like gh,
    // gcloud, and terraform to verify TLS certificates when using
    // httpProxyPort with a MITM proxy and custom CA.
    "enableWeakerNetworkIsolation": true,
    "network": {
      // Permits git commit signing, git fsmonitor, Docker socket, etc.
      "allowAllUnixSockets": true,
      "allowedHosts": ["api.anthropic.com", "code.claude.com"],
      // local dev servers, and other things that are weird and listen (clippy
      // --fix for some reason??)
      "allowLocalBinding": true,
    },
    "filesystem": {
      "allowWrite": [
        // rtk (CLI proxy) needs to write its state/config here
        "~/Library/Application Support/rtk",
        // Plain /tmp writes (as opposed to $TMPDIR) are the single biggest
        // source of self-inflicted sandbox EPERM noise -- redirects, quick
        // scratch files, background-job logs, etc. all default to /tmp out
        // of habit despite $TMPDIR being the documented scratch dir. Allow
        // it outright rather than fighting the habit.
        //
        // NOTE: on macOS this entry alone is a no-op. /tmp is a symlink to
        // /private/tmp and Seatbelt matches resolved paths, so the rule never
        // fires. claudeconfig.sh adds the "/private/tmp" twin at generate
        // time (and does the same for any /var or /etc entry), which is what
        // actually makes this work. Leave the plain spelling here: it is the
        // one that matters on Linux.
        "/tmp",
        // worktrunk (`wt`) centralizes every worktree under ~/worktrees --
        // see config/worktrunk/config.toml's worktree-path. claude/rules/
        // worktrees.md tells agents to prefer `wt` over EnterWorktree, so
        // without this the documented workflow EPERMs at every layer: `wt
        // switch --create` can't create the leading .git dirs, and once
        // inside a worktree even relative-path writes fail (the sandbox's
        // implicit cwd allowance only covers the session's original cwd,
        // not a directory the agent cd'd into).
        "~/worktrees",
      ],
    },
  },
}
