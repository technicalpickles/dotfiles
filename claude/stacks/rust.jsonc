{
  // Rust ecosystem
  "permissions": {
    "allow": [
      "Read(~/.cargo/registry/)",
      "Bash(cargo bench:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo info:*)",
      "Bash(cargo install:*)",
      "Bash(cargo new:*)",
      "Bash(cargo run:*)",
      "Bash(cargo search:*)",
      "Bash(cargo test:*)",
      "Bash(cargo update:*)",
      "Bash(cargo:*)",
      "Bash(rustc --version)",
      "Bash(rustc:*)",
      "Bash(rustfmt:*)",
      "Bash(rustup component:*)",
      "Bash(rustup default:*)",
      "Bash(rustup override:*)",
      "Bash(rustup show:*)",
      "Bash(rustup update:*)",
      "Bash(rustup:*)",
    ],
  },

  "sandbox": {
    "network": {
      "allowedDomains": [
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "docs.rs",
        "static.rust-lang.org",
      ],
    },

    // source: agent-safehouse
    "filesystem": {
      "allowWrite": [
        // ~/.cargo/bin is on PATH, and a new ~/.cargo/config.toml can set rustc-wrapper
        // or runner, so only the dirs and lock files cargo builds need are writable.
        // `cargo install` needs bin, so it has to run outside the sandbox.
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/.cargo/.global-cache",
        "~/.cargo/.package-cache",
        "~/.cargo/.package-cache-mutate",
        "~/.rustup",
        "~/.cache/cargo",
        "~/Library/Caches/cargo",
      ],
    },
  },
}
