{
  // Reference documentation sites
  "permissions": {
    "allow": ["WebFetch(domain:karafka.io)", "WebFetch(domain:lima-vm.io)"],
  },
  // source: agent-safehouse
  "sandbox": {
    "network": {
      "allowedHosts": [
        "karafka.io",
        "lima-vm.io",
        "code.visualstudio.com",
        "containers.dev",
        "docs.aws.amazon.com",
        "docs.lefthook.io",
        "playwright.dev",
      ],
    },
  },
}
