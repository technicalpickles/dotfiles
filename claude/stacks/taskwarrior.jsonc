{
  "permissions": {
    "allow": ["Bash(task:*)"],
  },

  // Auto mode carve-out for the same CLI, as prose the classifier can use.
  // This used to be `Bash(task:*) in technicalpickles/dotfiles`, permission
  // syntax scoped to one repo; `task <id> done` in other repos was denied as
  // External System Writes. Taskwarrior is the backlog system everywhere
  // (claude/rules/taskwarrior.md). See ADR 0056.
  "autoMode": {
    "allow": [
      "`task` (taskwarrior) is the user's (Josh's) personal backlog system in every repo and from any cwd on this machine (claude/rules/taskwarrior.md). `task add`, `done`, `annotate`, `modify`, `start`, `stop`, `export` and its reports on the user's own tasks are routine wherever the session started, not External System Writes or Remote Shell Writes. `task delete` and `task purge` stay under the defaults.",
    ],
  },
  "sandbox": {
    "filesystem": {
      "allowWrite": ["~/.task"],
    },
  },
}
