{
  // Single source of truth for MCP servers registered into ~/.claude.json
  // (user scope, available in all projects).
  //
  // Consumed by:
  //   - claudeconfig.sh -> configure_mcp_servers() registers each via the
  //     `claude mcp` CLI. Claude owns ~/.claude.json's format, so we drive the
  //     CLI rather than hand-editing the file.
  //
  // Registration is add-if-missing (idempotent), matching marketplaces. To
  // change an existing server's url/transport, remove it first, then re-run:
  //   claude mcp remove <name> -s user && ./claudeconfig.sh
  //
  // Each entry key is the server name. Supported transports: "http" and "sse"
  // (take "url"), and "stdio" (takes "command" plus optional "args" array).
  // Optional "excludeRoles" lists DOTPICKLES_ROLE values that skip the server.
  "servers": {
    // DeusData/codebase-memory-mcp, installed via mise. Upstream's `install`
    // also adds agents/skill/hooks to ~/.claude; deliberately not used.
    "codebase-memory-mcp": {
      "transport": "stdio",
      "command": "codebase-memory-mcp",
    },
    // qmd semantic search over the Obsidian vault. Served by the
    // com.technicalpickles.qmd-mcp LaunchAgent (localhost:18181, arm64 macOS).
    "qmd": {
      "transport": "http",
      "url": "http://localhost:18181/mcp",
      // No LaunchAgent (or vault) in a Coder workspace.
      "excludeRoles": ["work-coder"],
    },
  },
}
