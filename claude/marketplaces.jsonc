{
  // Single source of truth for Claude Code marketplaces + plugin bundles.
  //
  // Consumed by:
  //   - claudeconfig.sh         -> claude/configure-marketplaces.sh clones these globally
  //   - cloud-project-setup.sh  -> writes a repo's committed .claude/settings.json
  //                                (extraKnownMarketplaces + enabledPlugins) so
  //                                Claude Code on the web picks the plugins up.
  //
  // "autoUpdate": true makes claudeconfig.sh write autoUpdate into
  // ~/.claude/plugins/known_marketplaces.json (new entries, and existing ones
  // that lack the key; an explicit false set in /plugin is left alone).
  //
  // Marketplace KEYS here are the local aliases we choose. They are free-choice,
  // but enabledPlugins references them as "<plugin>@<key>", so the key in
  // "marketplaces" and the suffix in a profile entry must match. The plugin names
  // come from each repo's .claude-plugin/marketplace.json "plugins[].name".
  "marketplaces": {
    // obra/superpowers-marketplace is the umbrella that bundles superpowers,
    // elements-of-style, superpowers-chrome, developing-for-claude-code, etc.
    // (NOT bare obra/superpowers, which is a single-plugin marketplace.)
    //
    // autoUpdate is off on purpose, and superpowers is pinned to 6.4.2 (commit
    // 8ca22dba) because 7.0.0's brainstorming skill opens every session with
    // "if you'd rather skip the questions..." plus an open question, even when a
    // spec or handoff already answers it (obra/superpowers#2530).
    //
    // "pin" is applied by claude/configure-marketplaces.sh: it writes "sha" into
    // that plugin's source in the cloned marketplace.json and runs `claude plugin
    // update`. It only holds while autoUpdate stays false, since a pull would
    // collide with the edit. To release: remove "pin", then
    // `claude plugin marketplace update superpowers-marketplace`, update the
    // plugin again, and set autoUpdate back to true.
    "superpowers-marketplace": {
      "repo": "obra/superpowers-marketplace",
      "autoUpdate": false,
      "pin": {
        "plugin": "superpowers",
        "sha": "8ca22dba9a94f28898bbce59f2537ff4d87c747d",
      },
    },
    "pickled-claude-plugins": {
      "repo": "technicalpickles/pickled-claude-plugins",
      "autoUpdate": true,
    },
    // Personal marketplaces for plugins enabled by hand in /plugin. Not in any
    // profile, so cloud-project-setup.sh ignores them; they are here so a fresh
    // personal machine clones them and gets autoUpdate. "excludeRoles" skips a
    // marketplace for those roles in claudeconfig.sh (not on work machines).
    "crit": {
      "repo": "tomasz-tomczyk/crit",
      "autoUpdate": true,
      "excludeRoles": ["work", "work-coder"],
    },
    "claude-community": {
      "repo": "anthropics/claude-plugins-community",
      "autoUpdate": true,
      "excludeRoles": ["work", "work-coder"],
    },
    "devfast": {
      "repo": "devdotfast/whiteboard",
      "autoUpdate": true,
      "excludeRoles": ["work", "work-coder"],
    },
    // pstack (michael-denyer's port of Lauren Tan's Cursor pstack). Install the
    // plugin by hand: `/plugin install pstack@pstack-claude`.
    "pstack-claude": {
      "repo": "michael-denyer/pstack-claude",
      "autoUpdate": true,
    },
  },

  // Named plugin bundles. Each entry is "<plugin-name>@<marketplace-key>".
  "profiles": {
    // Core workflows only.
    "core": ["superpowers@superpowers-marketplace"],
    // General-purpose coding set (default for personal repos).
    "dev": [
      "superpowers@superpowers-marketplace",
      "git@pickled-claude-plugins",
      "ci-cd-tools@pickled-claude-plugins",
      "dev-tools@pickled-claude-plugins",
      "working-in-monorepos@pickled-claude-plugins",
      "come-on@pickled-claude-plugins",
    ],
  },

  "defaultProfile": "dev",

  // Plugins to disable at user scope, keyed "<plugin>@<marketplace-key>" with
  // the roles that disable them. Applied by claude/configure-marketplaces.sh
  // via `claude plugin disable`; roles not listed are left alone.
  "disabledPlugins": {
    "github-actions@pickled-claude-plugins": ["work", "work-coder"],
  },
}
