;; Safehouse overrides for DOTPICKLES_ROLE=work (Gusto machine). Appended by
;; bin/safe after common.sb.

;; Pickleton: full read/write, matching Claude Code launched from the pt root.
;; Needed from repo worktrees too: parent CLAUDE.md, and `pt beans` writes
;; ~/pickleton/beans. Also the real target of ~/.pickles, ~/.gitconfig,
;; ~/.gitconfig.d (this repo lives at ~/pickleton/repos/dotfiles here).
(allow file-read* file-write*
    (home-subpath "/pickleton")
)

;; pickletown CLI: reads its root from config.yml; session association reads the
;; live dolt sql-server's pid:port:uuid, then talks localhost TCP. Info file
;; only, not the dolt store.
(allow file-read*
    (home-subpath "/.config/pickletown")
    (home-literal "/.local/state/pickletown/dolt/.dolt/sql-server.info")
)

;; Gusto-managed PATH entry /pkg/env/global/bin doesn't exist, but stat must not
;; EPERM or Node's PATH walk stops before /opt/homebrew/bin.
(allow file-read*
    (subpath "/pkg")
)

;; Gusto's managed pi (/opt/gusto/bin/pi) is a dotslash wrapper that downloads
;; and caches the real binary on first run.
(allow file-read* file-write*
    (home-subpath "/Library/Caches/dotslash")
)

;; Dotslash-launched tools (/opt/gusto/bin/cloudsmith, pi, ...) also need to
;; stat the cache dir's parent. Without it they exit 255 with no output and no
;; logged deny, from any cwd except ~ (where safehouse grants all of home).
;; Metadata only: file-read-data on it isn't enough, and isn't needed.
(allow file-read-metadata
    (home-literal "/Library/Caches")
)

;; Pre-commit hooks in Gusto's Ruby repos write tool caches (sorbet's gem-rbis
;; died with EPERM). Rubocop's lives outside the bundler and rubygems dirs that
;; safehouse's ruby profile already covers.
(allow file-read* file-write*
    (home-subpath "/.cache/sorbet")
    (home-subpath "/.cache/rubocop_cache")
)

;; Skills that live in the Obsidian vault and are symlinked into
;; ~/.prime/agent/skills. Seatbelt checks the resolved path, so the link alone
;; isn't enough: without this read, prime-agent gets EPERM on the skill's
;; SKILL.md. Read-only, scoped to the one skill rather than the vault. The
;; vault path is per machine, hence per role.
(allow file-read*
    (home-subpath "/Vaults/pickled-knowledge/2.🏡 Areas/writing/writing-voice")
)

;; Escape guard. The ~/pickleton grant above reaches files that run OUTSIDE
;; the sandbox later. Later rules win, so deny writes to them back:
;;  - the dotfiles worktree that ~/.pickles, ~/.gitconfig*, shell rc files,
;;    ~/.config/* (including this policy) and bin/safe link into. Edit dotfiles
;;    from another worktree and merge, never in place.
;;  - git hooks and config in every repo: hooks and options like core.fsmonitor
;;    or core.sshCommand run with full access on Josh's next unsandboxed git
;;    call. Mirrors Claude Code's hardcoded .git/hooks + .git/config denies.
;; Interim deny list, not a full model: see ADR 0060 consequences.
(deny file-write*
    (home-subpath "/pickleton/repos/dotfiles/worktrees/main")
    (regex (string-append "^" HOME_DIR "/pickleton/(.+/)?\\.git/(hooks(/.*)?|config)$"))
    (regex (string-append "^" HOME_DIR "/pickleton/repos/[^/]+/bare\\.git/(hooks(/.*)?|config|worktrees/[^/]+/config\\.worktree)$"))
)
