#!/usr/bin/env bash
# Regenerate prime/models.home.json from the Ollama Cloud catalog.
#
#   prime-models            rewrite prime/models.home.json
#   prime-models --stdout   print it instead
#   prime-models --check    also send each model one tiny request through the
#                           local Ollama server, and drop the ones it rejects
#                           (retired models error with a replacement)
#
# Keeps the newest version of each model family from ollama.com/v1/models, with
# all its variants (glm-5.3 and glm-5.3-flash), and skips date-pinned tags
# (:0813). Names get the :cloud suffix, which works without an `ollama pull`.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="$root/prime/models.home.json"
host="${OLLAMA_HOST:-http://localhost:11434}"
stdout=""
check=""

for arg in "$@"; do
  case "$arg" in
    --stdout) stdout=1 ;;
    --check) check=1 ;;
    -h | --help)
      sed -n 2,12p "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "prime-models: unknown option $arg" >&2
      exit 2
      ;;
  esac
done

# Family is the name before its version: glm-5.3-flash is family "glm" at 5.3,
# kimi-k3 is "kimi-k" at 3. Names without a version are their own family.
ids=$(curl -fsS -m 30 https://ollama.com/v1/models | jq -r '
  def parse:
    capture("^(?<base>[^:]+)(?::(?<tag>.*))?$") as $m
    | ([$m.base | capture("^(?<family>.*?)-?(?<ver>[0-9][0-9.]*)(?<rest>.*)$")] | first) as $v
    | {
        id: $m.base + (if $m.tag then ":" + $m.tag else "" end),
        tag: ($m.tag // ""),
        family: (if $v then $v.family else $m.base end),
        ver: (if $v then ($v.ver | split(".") | map(select(. != "") | tonumber)) else [] end)
      };
  [.data[].id | parse | select(.tag | test("^[0-9]{4}$") | not)]
  | group_by(.family)
  | map(. as $g | ($g | map(.ver) | max) as $top | $g | map(select(.ver == $top)))
  | flatten | map(.id) | sort | .[]')

if [ -z "$ids" ]; then
  echo "prime-models: empty catalog" >&2
  exit 1
fi

models=""
for id in $ids; do
  case "$id" in
    *:*) name="$id-cloud" ;;
    *) name="$id:cloud" ;;
  esac
  if [ -n "$check" ]; then
    reply=$(curl -sS -m 90 "$host/v1/chat/completions" -H 'Content-Type: application/json' \
      -d "{\"model\":\"$name\",\"max_tokens\":16,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" || true)
    if ! printf '%s' "$reply" | jq -e '.choices' > /dev/null 2>&1; then
      echo "prime-models: dropping $name: $(printf '%s' "$reply" | jq -r '.error.message // .error // "no reply"' 2> /dev/null | cut -c1-100)" >&2
      continue
    fi
  fi
  models="${models:+$models,
}        { \"id\": \"$name\" }"
done

if [ -z "$models" ]; then
  echo "prime-models: no models left" >&2
  exit 1
fi

json="{
  // Generated by bin/prime-models: the newest Ollama Cloud models, reached
  // through the local Ollama server (\`ollama signin\`), which holds the sign-in.
  // apiKey is required by prime-agent but Ollama ignores it. Linked to
  // ~/.prime/agent/models.json by prime.sh (home role only).
  \"providers\": {
    \"ollama\": {
      \"baseUrl\": \"http://localhost:11434/v1\",
      \"api\": \"openai-completions\",
      \"apiKey\": \"ollama\",
      \"models\": [
$models
      ]
    }
  }
}"

if [ -n "$stdout" ]; then
  printf '%s\n' "$json"
else
  printf '%s\n' "$json" > "$out"
  echo "prime-models: wrote ${out#"$root"/}"
fi
