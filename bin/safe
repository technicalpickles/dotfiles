#!/bin/sh
# safe: run a command under agent-safehouse with dotfiles' overrides.
#
#   safe pi
#   safe --env-pass=OPENROUTER_API_KEY -- pi
#
# Per-invocation grants, for tools that need a little more than the roles give:
#   SAFEHOUSE_ADD_DIRS / SAFEHOUSE_ADD_DIRS_RO / SAFEHOUSE_ENV_PASS
#                    safehouse's own env knobs: read-write dirs, read-only dirs,
#                    env var names to pass through
#   SAFE_SOCKET_DIRS colon-separated dirs where the command may bind, accept on
#                    and connect to unix sockets (daemons, worker IPC). Created
#                    if missing. Safehouse has no flag for sockets.
#   SAFE_TOOL        tool profile to use, when it isn't the command's basename
#   SAFE_ROOT        where per-tool private roots live (default ~/.local/share/safe)
#
# Tool profiles live in config/agent-safehouse/tools/<name>.{sb,sh}.
#
# Safehouse has no global config file and no env var for --append-profile or
# --enable, so this wrapper is how the overrides get applied. See
# doc/adr/0060-agent-safehouse-wrapper.md.

role="${DOTPICKLES_ROLE:-home}"
profiles="$HOME/.config/agent-safehouse"

# Agent git identity (ADR 0031): commits inside the sandbox sign as the agent,
# never as you. A dedicated ssh-agent holds only the agent keys, so the sandbox
# never sees the interactive agent and its personal key. load-agent-ssh-keys
# does the Keychain passphrase (ADR 0030) and skips keys Automic Vault serves
# (ADR 0059).
agent_sock="$HOME/.ssh/agent/safehouse.sock"
SSH_AUTH_SOCK="$agent_sock" ssh-add -l > /dev/null 2>&1
if [ $? -eq 2 ]; then # no agent listening
  mkdir -p "$(dirname "$agent_sock")"
  rm -f "$agent_sock"
  ssh-agent -a "$agent_sock" > /dev/null
fi
SSH_AUTH_SOCK="$agent_sock" load-agent-ssh-keys > /dev/null
export SSH_AUTH_SOCK="$agent_sock"

agent_gitconfig="$HOME/.gitconfig.d/claude-agent-$role"
if [ -f "$agent_gitconfig" ]; then
  export GIT_CONFIG_GLOBAL="$agent_gitconfig"
fi

# Order matters: role rules come last so their denies win over earlier allows.
role_profile=""
if [ -f "$profiles/role-$role.sb" ]; then
  role_profile="--append-profile=$profiles/role-$role.sb"
fi

# Optional safehouse features, each a deliberate hole in the sandbox:
#   clipboard        pbcopy/pbpaste work. Sandboxed code can also read the
#                    clipboard.
#   keychain         Keychain reads. Needed because gh keeps its token there;
#                    without it `gh auth status` says the token is invalid.
#                    Sandboxed code can read EVERY Keychain item you own. A
#                    narrower option is a dedicated token via --env-pass.
#   launch-services  `open` works (MCP OAuth sign-in, plannotator opening a
#                    browser). Without it: kLSUnknownErr -10810 from
#                    RunningBoard. Anything it launches runs OUTSIDE the
#                    sandbox with your full privileges, so it is an escape
#                    hatch (`open -a Terminal ...`) the role escape guards don't
#                    cover.
# Rationale and tradeoffs: doc/adr/0060-agent-safehouse-wrapper.md.

# Tool profiles (ADR 0064): tools/<name>.sb is appended after common.sb, and
# tools/<name>.sh is sourced to set env and grants. The tool is SAFE_TOOL, else
# the basename of the command (the arg after `--`, or the first non-option arg).
tool="${SAFE_TOOL:-}"
if [ -z "$tool" ]; then
  seen_dd=""
  first=""
  after_dd=""
  for arg in "$@"; do
    if [ -n "$seen_dd" ]; then
      after_dd=$arg
      break
    fi
    case $arg in
      --) seen_dd=1 ;;
      -*) ;;
      *) [ -n "$first" ] || first=$arg ;;
    esac
  done
  tool=$(basename "${after_dd:-$first}")
fi
case $tool in *[!A-Za-z0-9._-]*) tool="" ;; esac

tool_profile=""
if [ -n "$tool" ] && [ -f "$profiles/tools/$tool.sh" ]; then
  # The tool's private root: granted read-write, mode 700. A profile puts its
  # state under it, and SAFE_XDG_ISOLATE puts cache and XDG state there too.
  SAFE_TOOL_ROOT="${SAFE_ROOT:-$HOME/.local/share/safe}/$tool"
  mkdir -p "$SAFE_TOOL_ROOT"
  chmod 700 "$SAFE_TOOL_ROOT"
  SAFEHOUSE_ADD_DIRS="${SAFEHOUSE_ADD_DIRS:+$SAFEHOUSE_ADD_DIRS:}$SAFE_TOOL_ROOT"
  export SAFEHOUSE_ADD_DIRS

  # A profile sets plain variables, lists the ones the tool needs in
  # SAFE_TOOL_ENV (comma-separated, passed through the env strip), and may set
  # SAFE_XDG_ISOLATE=1 and SAFE_SOCKET_DIRS.
  SAFE_TOOL_ENV=""
  SAFE_XDG_ISOLATE=""
  # shellcheck disable=SC1090
  . "$profiles/tools/$tool.sh"

  if [ -n "$SAFE_XDG_ISOLATE" ]; then
    real_mise_state="${XDG_STATE_HOME:-$HOME/.local/state}/mise"
    mkdir -p "$SAFE_TOOL_ROOT/cache" "$SAFE_TOOL_ROOT/state/mise"
    # mise trust lives in its state dir. Seed the isolated copy one way so
    # existing repos stay trusted, without the tool being able to trust
    # anything in the real one. -n keeps trust the tool added itself.
    for trust_dir in trusted-configs tracked-configs; do
      [ -d "$real_mise_state/$trust_dir" ] && cp -RPn "$real_mise_state/$trust_dir" "$SAFE_TOOL_ROOT/state/mise/" 2> /dev/null
    done
    XDG_CACHE_HOME="$SAFE_TOOL_ROOT/cache"
    XDG_STATE_HOME="$SAFE_TOOL_ROOT/state"
    SAFE_TOOL_ENV="$SAFE_TOOL_ENV,XDG_CACHE_HOME,XDG_STATE_HOME"
  fi

  old_ifs=$IFS
  IFS=,
  for name in $SAFE_TOOL_ENV; do
    [ -n "$name" ] && export "$name"
  done
  IFS=$old_ifs
fi
[ -n "$tool" ] && [ -f "$profiles/tools/$tool.sb" ] && tool_profile="$profiles/tools/$tool.sb"

# SAFE_SOCKET_DIRS becomes a generated profile between common and role, so role
# denies still win. It needs cleanup afterwards, so that path can't exec.
socket_profile=""
if [ -n "${SAFE_SOCKET_DIRS:-}" ]; then
  socket_profile=$(mktemp "${TMPDIR:-/tmp}/safe-sockets.XXXXXX")
  trap 'rm -f "$socket_profile"' EXIT
  old_ifs=$IFS
  IFS=:
  for dir in $SAFE_SOCKET_DIRS; do
    [ -n "$dir" ] || continue
    mkdir -p "$dir"
    dir=$(cd "$dir" && pwd -P)
    printf '(allow network-bind (local unix-socket (subpath "%s")))\n' "$dir" >> "$socket_profile"
    printf '(allow network-inbound (local unix-socket (subpath "%s")))\n' "$dir" >> "$socket_profile"
    printf '(allow network-outbound (remote unix-socket (subpath "%s")))\n' "$dir" >> "$socket_profile"
  done
  IFS=$old_ifs
fi

set -- \
  --enable=clipboard,keychain,launch-services \
  --env-pass="SSH_AUTH_SOCK,GIT_CONFIG_GLOBAL${SAFE_TOOL_ENV:+,$SAFE_TOOL_ENV}" \
  --append-profile="$profiles/common.sb" \
  ${tool_profile:+--append-profile="$tool_profile"} \
  ${socket_profile:+--append-profile="$socket_profile"} \
  ${role_profile:+"$role_profile"} \
  "$@"

if [ -z "$socket_profile" ]; then
  exec safehouse "$@"
fi
safehouse "$@"
exit $?
